// 職員シフト作成サポート - データモデル
// 出典: 参考資料/職員情報マスター登録の内容について...txt(職員マスタ項目)、
//       参考資料/シフト作成に関する回答.pdf(残論点)、
//       docs/decisions/2026-09-07-project-kickoff.md(プロジェクトの位置づけ)
// 開発初期は SQLite。本番は PostgreSQL への切り替えを想定。
// AgriCamp・送迎プラン作成サポートのDBとは独立(共有しない)。

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// マスタ
// ---------------------------------------------------------------------------

// サービス内容(2026-09-09追加)。事業所ごとの通常開所時間の管理方法が異なる。
enum ServiceType {
  EMPLOYMENT_TYPE_B // 就労B型
  AFTER_SCHOOL_DAY_SERVICE // 放課後等デイサービス
}

model Facility {
  id          String       @id @default(cuid())
  name        String
  serviceType ServiceType?

  // 通常開所時間(就労B型: 学校開校日/休校日の区別なく単一の開所時間を使う)
  openTime  String? // "HH:mm"
  closeTime String? // "HH:mm"

  // 放課後等デイサービス専用: 学校開校日/学校休校日で開所時間が異なるため別々に持つ
  schoolDayOpenTime     String? // "HH:mm"(学校開校日の開始)
  schoolDayCloseTime    String? // "HH:mm"(学校開校日の終了)
  schoolOffDayOpenTime  String? // "HH:mm"(学校休校日の開始)
  schoolOffDayCloseTime String? // "HH:mm"(学校休校日の終了)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff             Staff[]
  requiredStaffings RequiredStaffing[]
  shiftAssignments  ShiftAssignment[]
}

// 権限設定(職員情報マスター登録項目②)
enum PermissionLevel {
  SYSTEM_ADMIN // システム管理者: マスターを含むすべての事項の編集権限
  ADMIN // 管理者: マスター登録内容は閲覧のみ / シフト情報は編集権限あり
  PLANNER // 予定作成者: マスターの閲覧・編集権限なし / シフト情報は編集権限あり
  GENERAL_STAFF // 一般職員: マスターの閲覧権限なし / シフト情報の閲覧のみ
}

// 職制区分(職員情報マスター登録項目③)
enum StaffEmploymentType {
  FULL_TIME_40H // 正社員(週40時間)
  FULL_TIME_32H // 正社員(週32時間)
  PART_TIME_WELFARE // パート(福祉職)
  PART_TIME_DRIVER // パート(運転専従)
  ARBEIT_TRANSPORT // アルバイト(送迎対象)
}

// 在籍ステータス(職員情報マスター登録項目④)
enum EmploymentStatus {
  ZAISEKI_CHU // 在籍中
  KYUSHOKU_CHU // 休職中
  REWORK // リワーク
  TAISHOKU // 退職
}

// 運転可能量区分(職員情報マスター登録項目⑤)。
// 兼務職員の平均的な運転業務量(運転時間)を1としたときの運転量Aの設定ランク。
// 当初はa〜gの7段階(BAND_1〜7)として定義していたが、2026-09-07に実データ
// (職員基本情報2026-9.pdf)を取り込んだところ実際の運用はA〜Hの8段階だったため、
// 実データのアルファベット表記にあわせて修正した。
// A〜Gの数値範囲は職員情報マスター登録項目のa〜gの定義を踏襲(A=a, ..., G=g)。
// H = 運転不可(2026-09-07確定)。
// 参照: docs/decisions/2026-09-07-driving-capacity-band-real-data.md
enum DrivingCapacityBand {
  BAND_A // 1.5 < A < 2.0
  BAND_B // 1.2 < A < 1.5
  BAND_C // 1.0 < A < 1.3
  BAND_D // 0.9 < A < 1.2
  BAND_E // 0.8 < A < 1.0
  BAND_F // 0.7 < A < 0.9
  BAND_G // A < 0.8
  BAND_H // 運転不可
}

model Staff {
  id                  String              @id @default(cuid())
  name                String
  permissionLevel     PermissionLevel     @default(GENERAL_STAFF)
  // 職員基本情報2026-9.pdfでは「システム管理者」区分の職員に職制の記載がなかったため
  // 任意項目に変更(2026-09-07)。
  employmentType      StaffEmploymentType?
  employmentStatus    EmploymentStatus    @default(ZAISEKI_CHU)
  drivingCapacityBand DrivingCapacityBand?
  // 児童指導員として配置可能か(2026-09-09追加)。放課後等デイサービス等の
  // 人員配置基準上、児童指導員として計上できる職員かどうかを管理する。
  canBeChildInstructor Boolean             @default(false)
  // 強度行動障害研修の修了有無(2026-09-09追加)。
  hasSevereBehaviorTraining Boolean        @default(false)
  phoneNumber         String?
  email               String?
  // 主な所属事業所(任意。職員は複数事業所を掛け持ちする場合があるため、
  // シフト割当ごとの事業所はShiftAssignment.facilityIdで個別に記録する)
  primaryFacilityId   String?
  primaryFacility     Facility?           @relation(fields: [primaryFacilityId], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  shiftAssignments ShiftAssignment[]
  daySchedules     StaffDaySchedule[]
  scheduleStatuses StaffScheduleStatus[]
}

// 必要配置人数マスタ(シフト作成に関する回答.pdf 論点3)。
// 現時点では曜日ごとの固定人数のみ。当日の利用人数に応じた変動ルールは未実装(今後の検討事項)。
model RequiredStaffing {
  id           String   @id @default(cuid())
  facilityId   String
  facility     Facility @relation(fields: [facilityId], references: [id])
  weekday      Int // 0=日曜 ... 6=土曜
  requiredCount Int

  // 放課後等デイサービス事業所専用の加算算定人数(2026-09-09追加)。
  // 就労B型など他のサービス内容では使用しない(nullのまま)。
  severeBehaviorAdditionCount     Int? // 加算算定を行う場合(強度行動障害)の必要人数
  instructorAdditionCount         Int? // 加算算定を行う場合(指導員加配)の必要人数

  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([facilityId, weekday])
}

enum ShiftAssignmentStatus {
  DRAFT // 下書き
  CONFIRMED // 確定
}

// 職員シフト割当。1人・1日・1事業所につき1レコード。
model ShiftAssignment {
  id         String                @id @default(cuid())
  date       DateTime // 対象日(時刻部分は無視し日付のみ扱う)
  staffId    String
  staff      Staff                 @relation(fields: [staffId], references: [id])
  facilityId String
  facility   Facility              @relation(fields: [facilityId], references: [id])
  startTime  String // "HH:mm"
  endTime    String // "HH:mm"
  status     ShiftAssignmentStatus @default(DRAFT)
  note       String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([date, staffId, facilityId])
}

// ---------------------------------------------------------------------------
// 職員別・日ごとのシフト設定(2026-09-08)
// 名前カードクリックで開く月次スケジュール編集画面で使用する。
// 正社員は勤務時間区分(WorkTimeCategory)から選択、パートは任意の時間を入力、
// アルバイトは出勤/休みのみを管理する(時間設定なし)。
// ---------------------------------------------------------------------------

// 勤務時間区分マスタ(例: J = 10:00〜19:00、休憩1h/実働8時間)。
// 正社員のシフト作成で選択肢として使う。今後A〜Iなど順次追加していく想定。
model WorkTimeCategory {
  id           String   @id @default(cuid())
  code         String   @unique // "J" 等、1〜数文字の識別コード
  label        String // "10:00〜19:00" など画面表示用
  startTime    String // "HH:mm"
  endTime      String // "HH:mm"
  breakMinutes Int
  workHours    Float // 実働時間(時間)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffDaySchedules StaffDaySchedule[]
}

enum DayScheduleType {
  WORK // 出勤
  OFF // 休日
}

// 休日の種別(dayType=OFFの場合のみ意味を持つ。2026-09-08追加)。
// 正社員のカレンダー式シフト作成で、希望休と有給を区別して表示するために使う。
enum OffType {
  REQUESTED // 希望休(カレンダー上は黄色)
  PAID_LEAVE // 有給(カレンダー上は薄いピンク)
}

// アルバイトの出勤ステータス(2026-09-09追加、dayType=WORKの場合のみ意味を持つ)。
// まず本人から聞いた「出勤可能日」を登録し(可)、必要人数を見ながら管理者が
// 手動で実際の出勤日として確定させる(出)、という2段階の運用に対応する。
enum ArbeitAvailability {
  AVAILABLE // 可: 出勤可能日として登録
  CONFIRMED // 出: 出勤日として確定
}

// 職員1人・1日ごとのシフト設定。
model StaffDaySchedule {
  id      String          @id @default(cuid())
  staffId String
  staff   Staff           @relation(fields: [staffId], references: [id])
  date    DateTime // 対象日(時刻部分は無視)
  dayType DayScheduleType @default(WORK)
  offType OffType? // dayType=OFFのときのみ設定(希望休 or 有給)

  // 正社員: 勤務時間区分マスタから選択
  workTimeCategoryId String?
  workTimeCategory   WorkTimeCategory? @relation(fields: [workTimeCategoryId], references: [id])

  // パート・正社員の任意設定: 任意の時間を直接入力(区分マスタは使わない)
  customStartTime String? // "HH:mm"
  customEndTime   String? // "HH:mm"

  // パートのカレンダー式シフト作成でのみ使用(2026-09-09追加)。
  // false: 「出勤時間の設定」で一括適用した基本の出勤時間(カレンダー表示は①)
  // true : その日だけ個別に変更した出勤時間(カレンダー表示は②)
  isOverride Boolean @default(false)

  // アルバイトのカレンダー式シフト作成でのみ使用(2026-09-09追加)。可/出の2段階。
  arbeitStatus ArbeitAvailability?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 運転専従パートの中抜け勤務(2026-09-09追加)。1日に複数の出退勤ブロックを持つ。
  timeBlocks StaffDayTimeBlock[]

  @@unique([staffId, date])
}

// 運転専従パートの出退勤ブロック(中抜け勤務: 1日のうちに複数回の出勤・退勤がある)。
// 例: 7:00〜8:30 / 12:00〜15:30 / 17:00〜18:00 の3ブロック。
// カレンダー・シフト表では記号「U」で表し、実働時間の合計を別途計算して表示する。
model StaffDayTimeBlock {
  id                 String           @id @default(cuid())
  staffDayScheduleId String
  staffDaySchedule   StaffDaySchedule @relation(fields: [staffDayScheduleId], references: [id], onDelete: Cascade)
  startTime          String // "HH:mm"
  endTime            String // "HH:mm"
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
}

// 職員×対象月ごとの「シフト設定完了」状態(2026-09-08追加、2026-09-09改訂)。
// 正社員のシフト作成画面で「設定終了」を押すとレコードが作成/更新される。
// isFinalized: 「設定終了」が一度でも押されたか(レコードが存在する = true)。
// isComplete: 押された時点で、対象月の全日に休日設定または勤務時間設定が
//   済んでいたか。trueならシフト作成トップの名前カードを黄色(完了)、
//   falseなら赤(作成途中)で表示する。
model StaffScheduleStatus {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id])
  month       String // "YYYY-MM"
  isFinalized Boolean  @default(false)
  isComplete  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([staffId, month])
}
