DATABASE_URL="file:./dev.db"
PORT=3011
# AgriCamp等の外部システムが /api/external/* を呼び出す際に必須のAPIキー。
# 未設定の場合、外部APIは常に401を返す(安全側に倒す)。
EXTERNAL_API_KEY=
# 送迎プラン作成サポートが GET /api/external/staff (職員マスタ参照) を呼び出す際に
# 必須のAPIキー。EXTERNAL_API_KEYとは別の値にする(呼び出し元ごとにキーを分離するため)。
STAFF_API_KEY=
# シフト確定時に出力するExcelファイル(新シフト表_<年>.xlsx)の保存先フォルダ。
# 未設定時は server/storage/exports/ に保存する(開発用フォールバック)。
# 本番機ではアソシエイト共有書類の共有ドライブ上のフォルダを指定する。
SHIFT_EXCEL_EXPORT_DIR=
# 上記Excelファイルの編集制限パスワード(シート保護)。未設定時は既定値を使用。
SHIFT_EXCEL_PASSWORD=
